{
  "name": "template-insurance-policy-checking",
  "version": "0.1.0",
  "private": true,
  "description": "Reconcile agreed insurance terms with issued policy documents and prepare evidence-backed policy checking reports for broker review.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "dev": "node scripts/mastra-cli.mjs dev",
    "build": "node scripts/mastra-cli.mjs build",
    "start": "node scripts/mastra-cli.mjs start",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "evaluate:live": "node --env-file-if-exists=.env --import ./tests/source-loader.mjs scripts/live-evaluation-runner.ts",
    "prepare:use-cases": "node --import ./tests/source-loader.mjs scripts/use-cases-generator.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.130",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@types/pdfkit": "0.17.7",
    "mastra": "latest",
    "oxfmt": "0.59.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3"
  }
}
