{
  "name": "mastra-customer-refund-agent",
  "version": "1.0.0",
  "description": "A template Mastra app demonstrating a customer support agent that triages inbound messages, drafts grounded responses from a policy knowledge base, and requests human approval before issuing refunds.",
  "private": true,
  "workspaces": [
    "support-demo-ui",
    "client-demo-ui"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs ./node_modules/mastra/dist/index.js dev",
    "build": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs ./node_modules/mastra/dist/index.js build",
    "build:web": "npm run --workspace support-demo-ui build",
    "dev:demo": "npm run --workspace client-demo-ui dev",
    "dev:client-demo": "npm run --workspace client-demo-ui dev --",
    "dev:support-demo": "npm run --workspace support-demo-ui dev --",
    "demo:setup": "npm run --workspace client-demo-ui setup --",
    "demo:local": "node --env-file-if-exists=.env scripts/demo-local.mjs",
    "build:demo": "npm run --workspace client-demo-ui build",
    "lint:demo": "npm run --workspace client-demo-ui lint",
    "typecheck:demo": "npm run --workspace client-demo-ui typecheck",
    "check:runtime": "node scripts/check-runtime.mjs",
    "start": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs ./node_modules/mastra/dist/index.js start",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:clean": "node scripts/clean-clone-smoke.mjs",
    "verify:pre-push": "node scripts/verify-pre-push.mjs",
    "local:seed": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs scripts/local-fixtures.mjs seed",
    "local:reset": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs scripts/local-fixtures.mjs reset",
    "local:retention": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs scripts/retention.mjs",
    "format:check": "oxfmt --check -c .oxfmtrc.json .",
    "lint": "oxlint --deny-warnings src test",
    "lint:web": "npm run --workspace support-demo-ui lint",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm run --workspace support-demo-ui typecheck",
    "eval:candidate-report": "node scripts/eval-candidate-report.mjs",
    "format": "oxfmt -c .oxfmtrc.json ."
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.15.0",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@mastra/core": "latest",
    "@mastra/evals": "latest",
    "@mastra/libsql": "latest",
    "@mastra/loggers": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "@mastra/rag": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "2.0.3",
    "@types/node": "24.13.3",
    "mastra": "latest",
    "oxfmt": "0.59.0",
    "oxlint": "1.81.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "raw-body": "4.0.0",
    "@hono/node-server": "2.1.6",
    "nanoid": "5.1.16",
    "shadcn": {
      "undici": "8.12.2"
    },
    "@dotenvx/dotenvx": {
      "undici": "8.12.2"
    },
    "oxfmt": {
      "tinypool": "2.1.2"
    },
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "vite": "8.3.4",
    "wsl-utils": "1.0.1"
  }
}
