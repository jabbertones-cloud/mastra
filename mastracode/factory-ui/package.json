{
  "name": "@internal/factory-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser application for MastraCode: React SPA, client data layer, Vite config, and UI tests. Produces the Factory SPA bundled by the Mastra CLI.",
  "scripts": {
    "dev": "MASTRACODE_ENV_DIR=../web vite --config src/vite.config.ts",
    "dev:api": "pnpm --dir ../web api",
    "build": "vite --config src/vite.config.ts build",
    "typecheck": "tsc --noEmit -p src/ui/tsconfig.json",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@mastra/client-js": "workspace:*",
    "@mastra/code-sdk": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/factory": "workspace:*",
    "@mastra/playground-ui": "workspace:*",
    "@mastra/react": "workspace:*",
    "@nangohq/frontend": "0.71.6",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "react-grab": "^0.1.50",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:ts6",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
