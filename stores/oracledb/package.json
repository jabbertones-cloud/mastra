{
  "name": "@mastra/oracledb",
  "version": "0.5.6",
  "description": "Oracle Database provider for Mastra storage and vector retrieval",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsdown --logLevel silent --config tsdown.config.ts",
    "prepack": "tsx ../../scripts/generate-package-docs.ts",
    "build:watch": "pnpm build:lib --watch",
    "pretest:integration": "docker compose up -d --wait",
    "posttest:integration": "docker compose down -v",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "oracledb": "^6.10.0"
  },
  "devDependencies": {
    "@internal/core": "workspace:*",
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.19.15",
    "@types/oracledb": "6.5.2",
    "@vitest/ui": "catalog:",
    "tsdown": "0.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.76.0-0 <2.0.0-0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "stores/oracledb"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
